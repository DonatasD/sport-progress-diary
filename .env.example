# Provided automatically by the Vercel ↔ Supabase integration (`vercel env pull`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for Strava webhooks (no user session) and token storage.
SUPABASE_SERVICE_ROLE_KEY=

# Strava integration (https://www.strava.com/settings/api). Optional: the app
# works without it, the Settings page just shows a "not configured" hint.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it back when validating the webhook subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=
